<?xml version="1.0" encoding="utf-8"?>
<!--
    The always-on service: one command, kept running.

    Deliberately not a second desktop screen. What a relay needs is the command
    itself, a switch, and the truth about whether it is running right now —
    everything else about this feature is invisible by design.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.WT.Caption"
            android:text="@string/svc_hint" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:hint="@string/svc_cmd_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/svcCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:minLines="2"
                android:gravity="top"
                android:inputType="textMultiLine|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/svcEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/svc_keep_running" />

        <TextView
            android:id="@+id/svcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Text.WT.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/svcBattery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:text="@string/svc_battery_action" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Text.WT.Section"
            android:text="@string/svc_log_title" />

        <ScrollView
            android:id="@+id/svcLogScroll"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="6dp"
            android:background="@color/console_bg"
            android:padding="10dp">

            <TextView
                android:id="@+id/svcLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/console_fg"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
