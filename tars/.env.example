# Copy to .env and fill in at least one free brain. No credit card needed.

# --- Brain: free cloud (pick one or both) ---
# Gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq    -> https://console.groq.com/keys
GROQ_API_KEY=

# --- Brain: order of preference (hybrid fallback) ---
TARS_BRAIN_ORDER=gemini,groq,ollama

# --- Brain: local/offline via Ollama (optional) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Optional model overrides ---
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# --- Personality (0–100), the in-film settings ---
TARS_HUMOR=90
TARS_HONESTY=90
TARS_SARCASM=30
TARS_NAME=TARS
