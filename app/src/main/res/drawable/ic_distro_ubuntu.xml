<!--
  Distribution marks are our own geometry, not copies of the projects' logos:
  those are trademarks, and reproducing them in a third-party app is a liability
  for no benefit. Each mark is a ring with a distinct interior figure, tinted by
  its distro accent, so the set reads as one family while staying tellable apart.

  Ubuntu: three nodes evenly around a ring — a community of peers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48"
    android:tint="@color/accent_ubuntu">

    <!-- Ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M24,7 A17,17 0 1,1 23.9,7" />

    <!-- Three nodes at 90°, 210°, 330° -->
    <path android:fillColor="#FFFFFF" android:pathData="M24,3 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    <path android:fillColor="#FFFFFF" android:pathData="M9.3,32.5 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    <path android:fillColor="#FFFFFF" android:pathData="M38.7,32.5 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />

    <!-- Centre -->
    <path android:fillColor="#FFFFFF" android:pathData="M24,24 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
