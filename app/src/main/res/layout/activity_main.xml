<?xml version="1.0" encoding="utf-8"?>
<!--
  The old screen was a title, a one-line status, two buttons, and a console
  filling half the display. It never said whether a session was running, how big
  anything was, or how far a 500 MB download had got — and it put a developer
  tool at the centre for a user who may never type a command.

  Now: a card that states what the active system is and what condition it is in,
  the action that follows from that state, and the console demoted to a panel
  that opens when wanted.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnPrimary"
        app:subtitleTextColor="#CCFFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Active system -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/heroIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Text.WT.Title" />

                            <TextView
                                android:id="@+id/heroSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                style="@style/Text.WT.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/heroChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:singleLine="false"
                        app:chipSpacingVertical="0dp" />

                    <!-- Determinate where possible: a 500 MB download behind an
                         indeterminate bar looks indistinguishable from a hang. -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/progressLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        style="@style/Text.WT.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textSize="15sp" />

                    <!-- Only shown when a session is already up, so returning to
                         a running desktop does not mean relaunching it. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resumeButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:text="@string/action_resume" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/distrosButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_distributions" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/desktopButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_desktop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resolutionButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_resolution" />
            </LinearLayout>

            <!-- Console, collapsed by default -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/consoleHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Text.WT.Section"
                            android:text="@string/console_title" />

                        <TextView
                            android:id="@+id/consoleToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.WT.Caption"
                            android:text="@string/console_show" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/consoleBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <ScrollView
                            android:id="@+id/logScroll"
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:background="@color/console_bg"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/logView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="11sp"
                                android:textColor="@color/console_fg"
                                android:textIsSelectable="true" />
                        </ScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                                android:hint="@string/cmd_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/cmdInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textSize="13sp"
                                    android:imeOptions="actionSend"
                                    android:inputType="textNoSuggestions" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/runButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_gravity="top"
                                android:minWidth="0dp"
                                android:text="@string/run" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
